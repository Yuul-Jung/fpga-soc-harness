      "regs": [
        {"off": "0x00", "name": "DATA",   "access": "WO", "desc": "하위 8비트 송신 시작, busy 중 무시"},
        {"off": "0x04", "name": "STATUS", "access": "RO", "desc": "bit0 = busy"}
      ]
    },
    {
      "base": "0x1002_0000",
      "size": "0x10000",
      "block": "ps2kbd",
      "regs": [
        {"off": "0x00", "name": "STATUS", "access": "RO",  "desc": "bit0 = kbd_ready (새 문자 수신 대기)"},
        {"off": "0x04", "name": "DATA",   "access": "RO/C","desc": "{22'h0, key_up, valid, ascii[7:0]}. 읽으면 kbd_ready 클리어"}
      ]
    }
  ],
