    ]
  },
  "bus_protocol": {
    "name": "mmio-lite",
    "signals": [
      {"name": "valid",        "dir": "master→bus", "desc": "요청 유효"},
      {"name": "we",           "dir": "master→bus", "desc": "1이면 쓰기"},
      {"name": "addr[31:0]",   "dir": "master→bus", "desc": "바이트 주소, 4바이트 정렬"},
      {"name": "wdata[31:0]",  "dir": "master→bus", "desc": "쓰기 데이터"},
      {"name": "rdata[31:0]",  "dir": "bus→master", "desc": "읽기 데이터 (조합)"},
      {"name": "ready",        "dir": "bus→master", "desc": "항상 1 (1사이클 접근)"}
    ],
    "note": "미매핑 주소 읽기는 0 반환. 대기 상태·오류 없음."
  },
  "integration": {
    "bus": "mmio-lite (자체, 단독 실행용)",
    "address_map": "custom",
    "compat": "incompatible",
    "target_map": "mbv-frozen-v2",
    "plan": "이 패키지는 단독 시뮬레이션·보드 확인용으로 자체 mmio-lite 버스(0x1000_xxxx~0x1002_xxxx)를 쓴다. 동결 맵(mbv-frozen-v2) 이식 계획: (1) GPIO·UART는 동결 맵 [00]/[02] AMD IP를 그대로 쓰고 드라이버를 맞춘다. (2) ps2_kbd는 동결 맵 [0B](0x400B_0000)에 IP 표준(64KB 창, 0xFFF0 ID/VER)으로 감싸서 AXI4-Lite 슬레이브로 등록한다. (3) demo_master 대신 MicroBlaze V + 폴링 드라이버(C) 또는 인터럽트(irq→INTC)로 교체한다.",
    "frozen_mapping": [
      {"block": "gpio",   "region": "[00] gpio_led_sw 0x4000_0000"},
      {"block": "uart",   "region": "[02] uart_lite   0x4002_0000"},
      {"block": "ps2kbd", "region": "[0B] kbd          0x400B_0000"}
    ]
  },
  "hierarchy": {
    "module": "basys3_top",
    "file": "rtl/basys3_top.v",
    "children": [
      {
        "module": "soc_top",
        "file": "rtl/soc_top.v",
