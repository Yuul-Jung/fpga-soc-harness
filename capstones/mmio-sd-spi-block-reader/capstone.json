          "name": "LED",
          "access": "RW",
          "desc": "하위 16비트가 LED 핀"
        },
        {
          "off": "0x04",
          "name": "SW",
          "access": "RO",
          "desc": "하위 16비트, 2단 동기화된 스위치"
        }
      ]
    },
    {
      "base": "0x1000_1000",
      "size": "0x1000",
      "block": "uart",
      "regs": [
        {
          "off": "0x00",
          "name": "DATA",
          "access": "WO",
          "desc": "하위 8비트 송신 시작. busy 중 쓰기는 무시"
        },
        {
          "off": "0x04",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0 = busy"
        }
      ]
    },
    {
      "base": "0x1000_2000",
      "size": "0x1000",
      "block": "sd",
      "regs": [
        {
          "off": "0x00",
          "name": "CTRL",
          "access": "WO",
          "desc": "bit0=초기화 시작, bit1=블록 읽기 시작(LBA 사용). busy 중 쓰기는 무시. 초기화 전 읽기 요청은 err만 세운다"
        },
        {
          "off": "0x04",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0=busy, bit1=init_done, bit2=err, bit3=sdhc. 새 요청 시 err 해제"
        },
        {
          "off": "0x08",
          "name": "LBA",
          "access": "RW",
          "desc": "블록 번호. SDHC는 인자 그대로, SDSC로 판정되면 <<9"
        },
        {
          "off": "0x0C",
          "name": "IDX",
          "access": "RW",
          "desc": "하위 9비트, 버퍼 읽기 위치(0~511)"
        },
        {
          "off": "0x10",
          "name": "DATA",
          "access": "RO",
          "desc": "하위 8비트 = 버퍼[IDX] (읽기 부작용 없음)"
        }
      ]
    }
  ],
