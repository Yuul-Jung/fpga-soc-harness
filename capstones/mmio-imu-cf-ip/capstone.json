  "howto": [
    {
      "title": "시뮬레이션 (iverilog)",
      "steps": [
        "make lint  — verilator로 rtl/*.v 문법 검사",
        "make sim   — iverilog+vvp로 tb_imu_cf.v 실행, PASS/FAIL 확인",
        "make synth — yosys로 자원 추정 (Vivado 수치와 다를 수 있음)"
      ]
    },
    {
      "title": "Vivado 합성",
      "steps": [
        "Vivado 2024.2에서 rtl/*.v를 프로젝트에 추가한다.",
        "constr/basys3_imu_cf.xdc를 제약 파일로 추가한다.",
        "top=basys3_imu_cf_top으로 합성한다.",
        "합성 후 LUT/FF/BRAM 사용량과 WNS를 기록한다."
      ]
    }
  ],
  "verification": {
