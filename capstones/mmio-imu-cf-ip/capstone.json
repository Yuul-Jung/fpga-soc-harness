  "memory_map": [
    {
      "base": "0x4019_0000",
      "size": "0x10000",
      "block": "axil_wrap",
      "desc": "IMU 상보 필터 IP 레지스터 맵 (제안: free_slots 슬롯 [19])",
      "regs": [
        {"off": "0x00", "name": "CTRL",    "access": "WO", "desc": "bit0: start (자동 클리어). 쓰면 필터 1스텝 계산 시작."},
        {"off": "0x04", "name": "STATUS",  "access": "RO", "desc": "bit0: done, bit1: busy"},
        {"off": "0x08", "name": "AY",      "access": "WO", "desc": "가속도 Y, 16비트 부호, Q2.14 (16384=1g)"},
        {"off": "0x0C", "name": "AZ",      "access": "WO", "desc": "가속도 Z, 16비트 부호, Q2.14"},
        {"off": "0x10", "name": "AX",      "access": "WO", "desc": "가속도 X, 16비트 부호, Q2.14 (피치용)"},
        {"off": "0x14", "name": "GX_DEL",  "access": "WO", "desc": "자이로 각도 증분 (degrees*512, 18비트 부호, [17:0]). 소프트: gx_dps/fs*512"},
        {"off": "0x18", "name": "ALPHA",   "access": "WO", "desc": "상보 필터 계수 alpha*65536. 기본값 64225(=0.98). 65536=alpha=1.0"},
        {"off": "0x1C", "name": "GY_DEL",  "access": "WO", "desc": "자이로 피치 증분 (degrees*512, 18비트 부호). gy_dps/fs*512"},
        {"off": "0x20", "name": "ROLL",    "access": "RO", "desc": "롤 각도 출력 (degrees*512, 18비트 부호, [17:0])"},
        {"off": "0x24", "name": "PITCH",   "access": "RO", "desc": "피치 각도 출력 (degrees*512, 18비트 부호, [17:0])"}
      ]
    }
  ],
