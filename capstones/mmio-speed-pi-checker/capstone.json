        "short": "MMIO decoder",
        "side": "core"
      },
      {
        "id": "gpio",
        "name": "gpio",
        "kind": "peripheral",
        "module": "gpio",
        "file": "rtl/gpio.v",
        "desc": "16-bit LED(RW, off=0x00), 16-bit SW(RO, 2단 동기화, off=0x04)",
        "short": "GPIO LED/SW",
        "side": "peripheral"
