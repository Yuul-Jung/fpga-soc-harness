  "memory_map": [
    {
      "base": "0x1000_0000", "size": "0x10000", "block": "gpio", "desc": "GPIO LED/SW",
      "regs": [
        {"off": "0x00", "name": "LED", "access": "RW", "desc": "LED[15:0]"},
        {"off": "0x04", "name": "SW",  "access": "RO", "desc": "SW[15:0] (2단 동기화)"}
      ]
    },
    {
      "base": "0x1001_0000", "size": "0x10000", "block": "uart", "desc": "UART TX",
      "regs": [
        {"off": "0x00", "name": "DATA",   "access": "WO", "desc": "송신 바이트 [7:0]"},
        {"off": "0x04", "name": "STATUS", "access": "RO", "desc": "bit0=busy"}
      ]
    },
    {
      "base": "0x1002_0000", "size": "0x10000", "block": "speed_pi", "desc": "속도 PI 제어",
      "regs": [
        {"off": "0x00",   "name": "CTRL",        "access": "RW",   "desc": "bit0=enable, bit1=clear_pos"},
        {"off": "0x04",   "name": "TARGET",       "access": "RW",   "desc": "[15:0] 목표 속도 (카운트/창)"},
        {"off": "0x08",   "name": "KP",           "access": "RW",   "desc": "[15:0] 비례 이득 8.8 고정소수점"},
        {"off": "0x0C",   "name": "KI",           "access": "RW",   "desc": "[15:0] 적분 이득 8.8 고정소수점"},
        {"off": "0x10",   "name": "SPEED",        "access": "RO",   "desc": "[15:0] 현재 속도 (카운트/창)"},
        {"off": "0x14",   "name": "PERIOD",       "access": "RW",   "desc": "[15:0] PWM 주기 (클럭 사이클)"},
        {"off": "0x18",   "name": "DUTY",         "access": "RO",   "desc": "[15:0] 현재 PWM 듀티 출력"},
        {"off": "0x1C",   "name": "MIN_DUTY",     "access": "RW",   "desc": "[15:0] 최소 PWM 듀티 (스톨 방지)"},
        {"off": "0xFFF0", "name": "ID",           "access": "RO",   "desc": "0x53504931 (SPI1)"},
        {"off": "0xFFF4", "name": "VER",          "access": "RO",   "desc": "0x01000001"},
        {"off": "0xFFF8", "name": "IRQ_STATUS",   "access": "RW1C", "desc": "bit0=speed_ready (창 완료)"},
        {"off": "0xFFFC", "name": "IRQ_ENABLE",   "access": "RW",   "desc": "bit0=speed_ready IRQ 허용"}
      ]
    }
  ],
