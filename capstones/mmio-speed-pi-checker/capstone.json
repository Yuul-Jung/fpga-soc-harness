        "short": "Board wrapper",
        "side": "top"
      },
      {
        "id": "soc",
        "name": "soc_top",
        "kind": "soc-core",
        "module": "soc_top",
        "file": "rtl/soc_top.v",
        "desc": "SoC 코어. MMIO 버스와 슬레이브 3개를 연결. 마스터 포트 노출(CPU 교체 지점)",
        "short": "SoC core",
        "side": "core"
      },
      {
        "id": "bus",
        "name": "mmio_bus",
