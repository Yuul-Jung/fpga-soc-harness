  "memory_map": [
    {
      "base": "0x1000_0000",
      "size": "0x1000",
      "block": "gpio",
      "regs": [
        {
          "off": "0x00",
          "name": "LED",
          "access": "RW",
          "desc": "하위 16비트가 LED 핀"
        },
        {
          "off": "0x04",
          "name": "SW",
          "access": "RO",
          "desc": "하위 16비트, 2단 동기화된 스위치"
        }
      ]
    },
    {
      "base": "0x1000_3000",
      "size": "0x1000",
      "block": "pwm",
      "regs": [
        {
          "off": "0x00",
          "name": "INC",
          "access": "RW",
          "desc": "위상 증가량. 주파수 = INC × 100MHz / 2^32 (440Hz ≈ 18898)"
        },
        {
          "off": "0x04",
          "name": "CTRL",
          "access": "RW",
          "desc": "bit0=enable. 0이면 위상 0으로 고정, PWM 0, SHUTDOWN_N 0"
        },
        {
          "off": "0x08",
          "name": "VOL",
          "access": "RW",
          "desc": "하위 8비트. 256 클럭 캐리어 중 high 개수(0~255)"
        },
        {
          "off": "0x0C",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0=현재 톤 비트(위상 최상위 비트)"
        }
      ]
    },
    {
      "base": "0x1000_4000",
      "size": "0x1000",
      "block": "vga",
      "regs": [
        {
          "off": "0x00",
          "name": "NOTE",
          "access": "RW",
          "desc": "하위 3비트. 막대 0..NOTE번이 켜짐(80화소 폭)"
        },
        {
          "off": "0x04",
          "name": "COLOR",
          "access": "RW",
          "desc": "하위 12비트 {R,G,B}, 리셋값 0x0F0"
        },
        {
          "off": "0x08",
          "name": "FRAME",
          "access": "RO",
          "desc": "vsync 프레임마다 +1 (16비트)"
        }
      ]
    }
  ],
