  "bus_protocol": {
    "name": "mmio-lite",
    "signals": [
      {"name": "valid", "dir": "M→S", "width": 1,  "desc": "트랜잭션 유효"},
      {"name": "we",    "dir": "M→S", "width": 1,  "desc": "쓰기=1, 읽기=0"},
      {"name": "addr",  "dir": "M→S", "width": 32, "desc": "바이트 주소"},
      {"name": "wdata", "dir": "M→S", "width": 32, "desc": "쓰기 데이터"},
      {"name": "rdata", "dir": "S→M", "width": 32, "desc": "읽기 데이터 (버스 MUX 출력)"},
      {"name": "ready", "dir": "S→M", "width": 1,  "desc": "항상 1 (1사이클 응답)"}
    ],
    "note": "back-pressure 없음. valid 사이클에 always 응답. AXI4-Lite 비호환"
  },
  "integration": {
    "bus": "mmio-lite",
    "address_map": "custom",
    "compat": "incompatible",
    "target_map": "mbv-frozen-v2",
    "plan": "mbv-frozen-v2 맵으로 이전 시 motor_safety=[18]=0x4018_0000 슬롯 사용(free_slots 제안). 이 패키지는 시뮬레이션 전용 주소(0x1000~0x1002 세그먼트)를 사용하므로 compat=incompatible. IRQ는 slot 13(free_slots 첫 번째)을 제안.",
    "frozen_mapping": [
      {"block": "safety", "region": "motor_safety", "base": "0x4018_0000", "intc": 13}
    ]
  },
  "external_parts": [],
  "schematic": {
    "state": "not-written",
    "note": "이 패키지는 시뮬레이션 전용이며 외부 부품이 없어 회로도 미작성. 실제 사용 시 H-브리지(TB6612FNG 또는 DRV8833), 전류 센서, 레벨 변환 회로 필요."
  },
  "hierarchy": {
    "module": "basys3_top",
    "file": "rtl/basys3_top.v",
    "children": [
      {"module": "demo_master", "file": "rtl/demo_master.v"},
      {
        "module": "soc_top",
