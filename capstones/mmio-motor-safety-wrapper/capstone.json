          {"module": "uart_tx",         "file": "rtl/uart_tx.v"},
          {"module": "motor_safety_ip", "file": "rtl/motor_safety_ip.v"}
        ]
      }
    ]
  },
  "memory_map": [
    {
      "base": "0x1000_0000", "size": "0x10000", "block": "gpio", "desc": "GPIO LED/SW",
      "regs": [
        {"off": "0x00", "name": "LED", "access": "RW", "desc": "LED[15:0]"},
        {"off": "0x04", "name": "SW",  "access": "RO", "desc": "SW[15:0] (2단 동기화)"}
      ]
    },
    {
      "base": "0x1001_0000", "size": "0x10000", "block": "uart", "desc": "UART TX",
      "regs": [
        {"off": "0x00", "name": "DATA",   "access": "WO", "desc": "송신 바이트 [7:0]"},
        {"off": "0x04", "name": "STATUS", "access": "RO", "desc": "bit0=busy"}
      ]
    },
    {
      "base": "0x1002_0000", "size": "0x10000", "block": "safety", "desc": "모터 안전 래퍼",
      "regs": [
        {"off": "0x00",   "name": "CTRL",       "access": "RW",   "desc": "bit0=enable, bit1=oc_clear(자동 소거), bit2=dt_bypass"},
        {"off": "0x04",   "name": "DT_CYCLES",  "access": "RW",   "desc": "[15:0] 데드타임 클럭 사이클 수 (기본값=10)"},
        {"off": "0x08",   "name": "STATUS",     "access": "RO",   "desc": "bit0=oc_latched, bit1=active(enable&!oc_latched)"},
        {"off": "0x0C",   "name": "PWM_IN",     "access": "RW",   "desc": "[3:0]={BL_in,BH_in,AL_in,AH_in} — CPU 또는 외부 PWM 소스"},
        {"off": "0x10",   "name": "PWM_OUT",    "access": "RO",   "desc": "[3:0]={BL_out,BH_out,AL_out,AH_out} — 보호 적용 후 출력"},
        {"off": "0xFFF0", "name": "ID",         "access": "RO",   "desc": "0x4D535731 (MSW1)"},
        {"off": "0xFFF4", "name": "VER",        "access": "RO",   "desc": "0x01000001"},
        {"off": "0xFFF8", "name": "IRQ_STATUS", "access": "RW1C", "desc": "bit0=oc_event (과전류 발생 시 셋)"},
        {"off": "0xFFFC", "name": "IRQ_ENABLE", "access": "RW",   "desc": "bit0=oc_irq_en"}
      ]
    }
  ],
