  "bus_protocol": {
    "name": "mmio-lite",
    "signals": [
      {
        "name": "valid",
        "dir": "M→S",
        "width": 1,
        "desc": "트랜잭션 유효"
      },
      {
        "name": "we",
        "dir": "M→S",
        "width": 1,
        "desc": "쓰기=1, 읽기=0"
      },
      {
        "name": "addr",
        "dir": "M→S",
        "width": 32,
        "desc": "바이트 주소"
      },
      {
        "name": "wdata",
        "dir": "M→S",
        "width": 32,
        "desc": "쓰기 데이터"
      },
      {
        "name": "rdata",
        "dir": "S→M",
        "width": 32,
        "desc": "읽기 데이터 (버스 MUX 출력)"
      },
      {
        "name": "ready",
        "dir": "S→M",
        "width": 1,
        "desc": "항상 1 (1사이클 응답)"
      }
    ],
    "note": "back-pressure 없음. valid 사이클에 always 응답. AXI4-Lite 비호환"
  },
  "integration": {
    "bus": "mmio-lite",
    "address_map": "custom",
    "compat": "incompatible",
    "target_map": "mbv-frozen-v2",
    "plan": "mbv-frozen-v2 맵으로 이전 시 pid_cap=[16]=0x4016_0000 슬롯 사용(free_slots 첫 빈 칸). INTC 13 사용(free_intc 첫 빈 번호). 이 패키지는 시뮬레이션 전용 주소(0x1000~0x1002 세그먼트)를 사용하므로 compat=incompatible.",
    "frozen_mapping": [
      {
        "block": "pid_cap",
        "region": "pid_cap_ip",
        "base": "0x4016_0000",
        "intc": 13
      }
    ]
  },
