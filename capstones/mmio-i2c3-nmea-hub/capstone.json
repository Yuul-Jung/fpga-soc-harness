  "memory_map": [
    {
      "region": "hub_regs",
      "base": "0x401D_0000",
      "size": "0x10000",
      "block": "axil_wrap",
      "note": "제안값. 동결 맵 free_slots[1D] 배정 대기.",
      "regs": [
        {
          "off": "0x0000",
          "name": "CTRL",
          "access": "RW",
          "desc": "bit0=EN, bit1=UART_EN, bit7=FIFO_CLR(자동클리어), bit8=TEST_MODE(직접FIFO주입)"
        },
        {
          "off": "0x0004",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0=FIFO_EMPTY, bit1=FIFO_FULL, bit2=TIMEOUT(I2C ACK 없음)"
        },
        {
          "off": "0x0008",
          "name": "FIFO_DATA",
          "access": "RO",
          "desc": "팝온읽기. [31:24]=sensor_id(0~3), [23:0]=raw_data. FIFO_EMPTY이면 0 반환"
        },
        {
          "off": "0x000C",
          "name": "FIFO_TS",
          "access": "RO",
          "desc": "FIFO_DATA 팝과 함께 갱신되는 타임스탬프(자유실행 카운터)"
        },
        {
          "off": "0x0010",
          "name": "FIFO_CNT",
          "access": "RO",
          "desc": "[4:0] FIFO 적재 수"
        },
        {
          "off": "0x0014",
          "name": "I2C_DIV",
          "access": "RW",
          "desc": "I2C 비트 클럭 분주(기본 1000 → 100kHz@100MHz). 최소 8."
        },
        {
          "off": "0x0018",
          "name": "UART_DIV",
          "access": "RW",
          "desc": "UART 비트 클럭 분주(기본 10417 → 9600baud@100MHz)."
        },
        {
          "off": "0x001C",
          "name": "FIFO_INJ",
          "access": "WO",
          "desc": "TEST_MODE에서만 유효. [31:24]=sensor_id, [23:0]=data. 직접 FIFO 주입."
        },
        {
          "off": "0xFFF0",
          "name": "ID_REG",
          "access": "RO",
          "desc": "0x48554231 (ASCII HUB1)"
        },
        {
          "off": "0xFFF4",
          "name": "VER_REG",
          "access": "RO",
          "desc": "0x00010000 (v1.0.0)"
        },
        {
          "off": "0xFFF8",
          "name": "IRQ_EN",
          "access": "RW",
          "desc": "bit0=인터럽트 활성"
        },
        {
          "off": "0xFFFC",
          "name": "IRQ_PEND",
          "access": "RW",
          "desc": "bit0=FIFO 비지않음·NMEA완료(W1C)"
        }
      ]
    }
  ],
