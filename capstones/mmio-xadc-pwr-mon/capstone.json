        {"off": "0x000C", "name": "VCCAUX",       "access": "RO",  "desc": "[15:4]=12비트 원시값 (DRP 0x02)"},
        {"off": "0x0010", "name": "VCCBRAM",      "access": "RO",  "desc": "[15:4]=12비트 원시값 (DRP 0x06)"},
        {"off": "0x0014", "name": "THR_INT_LO",   "access": "RW",  "desc": "[11:0]=Vccint 하한 임계값"},
        {"off": "0x0018", "name": "THR_INT_HI",   "access": "RW",  "desc": "[11:0]=Vccint 상한 임계값"},
