        {"off": "0x0020", "name": "THR_AUX_HI",   "access": "RW",  "desc": "[11:0]=Vccaux 상한 임계값"},
        {"off": "0x0024", "name": "THR_BRAM_LO",  "access": "RW",  "desc": "[11:0]=Vccbram 하한 임계값"},
        {"off": "0x0028", "name": "THR_BRAM_HI",  "access": "RW",  "desc": "[11:0]=Vccbram 상한 임계값"},
        {"off": "0xFFF0", "name": "IP_ID",         "access": "RO",  "desc": "0x5841_504D (ASCII 'XAPM')"},
        {"off": "0xFFF4", "name": "IP_VER",        "access": "RO",  "desc": "0x0000_0100 (Rev 1.0)"},
