  "bus_protocol": {
    "name": "AXI4-Lite",
    "addr_width": 32,
    "data_width": 32,
    "signals": [
      { "name": "s_axil_awaddr",  "dir": "in",  "width": 8,  "desc": "쓰기 주소 (오프셋)" },
      { "name": "s_axil_awvalid", "dir": "in",  "width": 1,  "desc": "쓰기 주소 유효" },
      { "name": "s_axil_awready", "dir": "out", "width": 1,  "desc": "쓰기 주소 준비" },
      { "name": "s_axil_wdata",   "dir": "in",  "width": 32, "desc": "쓰기 데이터" },
      { "name": "s_axil_wstrb",   "dir": "in",  "width": 4,  "desc": "쓰기 스트로브" },
      { "name": "s_axil_wvalid",  "dir": "in",  "width": 1,  "desc": "쓰기 데이터 유효" },
      { "name": "s_axil_wready",  "dir": "out", "width": 1,  "desc": "쓰기 데이터 준비" },
      { "name": "s_axil_bresp",   "dir": "out", "width": 2,  "desc": "쓰기 응답 (00=OKAY)" },
      { "name": "s_axil_bvalid",  "dir": "out", "width": 1,  "desc": "쓰기 응답 유효" },
      { "name": "s_axil_bready",  "dir": "in",  "width": 1,  "desc": "쓰기 응답 준비" },
      { "name": "s_axil_araddr",  "dir": "in",  "width": 8,  "desc": "읽기 주소 (오프셋)" },
      { "name": "s_axil_arvalid", "dir": "in",  "width": 1,  "desc": "읽기 주소 유효" },
      { "name": "s_axil_arready", "dir": "out", "width": 1,  "desc": "읽기 주소 준비" },
      { "name": "s_axil_rdata",   "dir": "out", "width": 32, "desc": "읽기 데이터" },
      { "name": "s_axil_rresp",   "dir": "out", "width": 2,  "desc": "읽기 응답" },
      { "name": "s_axil_rvalid",  "dir": "out", "width": 1,  "desc": "읽기 데이터 유효" },
      { "name": "s_axil_rready",  "dir": "in",  "width": 1,  "desc": "읽기 데이터 준비" }
    ],
    "note": "단일 슬레이브. BREADY/RREADY 항상 1 가정. 주소 폭은 8비트 (256바이트 오프셋 공간)."
  },
