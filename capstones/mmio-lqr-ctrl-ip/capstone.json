  "memory_map": [
    {
      "base": "0x401C_0000",
      "size": "0x10000",
      "block": "axil_wrap",
      "desc": "LQR 제어기 IP 레지스터 맵 (제안: free_slots 슬롯 [1C])",
      "regs": [
        { "off": "0x00", "name": "CTRL",    "access": "WO", "desc": "bit0=start (1클럭 자동 클리어)" },
        { "off": "0x04", "name": "STATUS",  "access": "RO", "desc": "bit0=done, bit1=busy" },
        { "off": "0x08", "name": "K0",      "access": "RW", "desc": "이득 K[0] (Q8.8 부호, cart position)" },
        { "off": "0x0C", "name": "K1",      "access": "RW", "desc": "이득 K[1] (Q8.8 부호, cart velocity)" },
        { "off": "0x10", "name": "K2",      "access": "RW", "desc": "이득 K[2] (Q8.8 부호, pole angle θ)" },
        { "off": "0x14", "name": "K3",      "access": "RW", "desc": "이득 K[3] (Q8.8 부호, pole rate dθ)" },
        { "off": "0x18", "name": "X_STATE", "access": "WO", "desc": "상태 x (cart position, Q8.8 부호)" },
        { "off": "0x1C", "name": "DX_STATE","access": "WO", "desc": "상태 dx (cart velocity, Q8.8 부호)" },
        { "off": "0x20", "name": "THETA",   "access": "WO", "desc": "상태 θ (pole angle, Q8.8 부호)" },
        { "off": "0x24", "name": "DTHETA",  "access": "WO", "desc": "상태 dθ (pole rate, Q8.8 부호)" },
        { "off": "0x28", "name": "U_OUT",   "access": "RO", "desc": "제어 출력 u (Q8.8 부호, 포화 처리됨)" },
        { "off": "0x2C", "name": "IRQ_STATUS","access":"RW1C","desc":"bit0=done_irq (쓰기1 클리어)" },
        { "off": "0x30", "name": "IRQ_ENABLE","access":"RW",  "desc":"bit0=done_irq_en" }
      ]
    }
  ],
