        "name": "basys3_mac_top",
        "kind": "top",
        "module": "basys3_mac_top",
        "file": "rtl/multi_axis_motion_ip.v",
        "desc": "Basys3 최상위 래퍼. CLK100MHZ 입력, Pmod JA·JB에 엔코더·PWM 연결",
        "short": "Board top",
        "side": "left"
