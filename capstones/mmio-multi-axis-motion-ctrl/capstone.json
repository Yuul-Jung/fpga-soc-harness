      {"from": "ip",  "to": "pwm_b", "label": "cb_duty[9:0]"},
      {"from": "enc_a", "to": "ip", "label": "cnt_a[15:0]"},
      {"from": "enc_b", "to": "ip", "label": "cnt_b[15:0]"},
      {"from": "pwm_a", "to": "top", "label": "pwm_a_o"},
      {"from": "pwm_b", "to": "top", "label": "pwm_b_o"}
    ]
  },

  "bus_protocol": {
    "name": "MMIO-lite",
    "signals": [
      {"name": "valid", "dir": "in",  "width": 1,  "desc": "트랜잭션 유효"},
      {"name": "we",    "dir": "in",  "width": 1,  "desc": "1=쓰기, 0=읽기"},
      {"name": "addr",  "dir": "in",  "width": 32, "desc": "주소 (addr[15:0]만 디코딩)"},
      {"name": "wdata", "dir": "in",  "width": 32, "desc": "쓰기 데이터"},
      {"name": "rdata", "dir": "out", "width": 32, "desc": "읽기 데이터 (1사이클 레이턴시)"}
    ],
    "latency": "1 cycle",
    "note": "addr[15:0]만 디코딩. valid&&we 동시에 1일 때 쓰기."
  },

  "integration": {
    "bus": "mmio-lite",
    "address_map": "custom",
    "compat": "partial",
    "target_map": "mbv-frozen-v2",
    "plan": "free_slots [17]=0x4017_0000 사용(제안: [16]은 mmio-qenc-diag-checker에 배정됨). 프로젝트 측에서 동결 필요. IRQ 13 배정(intc_free 첫 번호). 동결 완료 시 address_map을 mbv-frozen-v2로 변경하고 frozen_mapping을 추가한다.",
    "frozen_mapping": []
  },

  "external_parts": [
    {
      "id": "enc_a",
      "name": "직교 엔코더 모터 A",
      "block": "enc_a_ext",
      "interface": "quadrature (A/B 2신호)",
      "io_voltage": "3.3V 또는 5V",
      "qty": 1,
      "board_resident": false,
      "supply_voltage": "5V 또는 12V (모터 전원 별도)",
      "level_shift": "5V 신호 사용 시 필요 (TXS0102 등)",
      "power_note": "5V 엔코더 신호는 레벨 변환 필요(TXS0102 등). 모터 전원은 Basys3와 완전 분리, GND 공통.",
      "arduino_compatible": true,
