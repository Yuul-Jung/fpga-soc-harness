  "memory_map": [
    {
      "base": "0x4017_0000",
      "size": "0x10000",
      "block": "ip",
      "desc": "multi_axis_motion_ip 레지스터 공간 (slot [17], intc=13, 동결 전 제안)",
      "regs": [
        {"off": "0x0000", "name": "CTRL",      "access": "RW",   "desc": "[0]=enable, [1]=emstop (즉시 PWM=0 게이트)"},
        {"off": "0x0004", "name": "PERIOD",    "access": "RW",   "desc": "[19:0] 주기 클럭 수 (기본 100000 = 1kHz@100MHz)"},
        {"off": "0x0008", "name": "STATUS",    "access": "RO",   "desc": "[0]=period_tick(셀프클리어) [1]=ch_a_sat [2]=ch_b_sat"},
        {"off": "0x0010", "name": "CA_SETPT",  "access": "RW",   "desc": "[15:0] 채널A 목표 속도 (부호있는 카운트/주기)"},
        {"off": "0x0014", "name": "CA_KP",     "access": "RW",   "desc": "[15:0] 채널A Kp Q4.12"},
        {"off": "0x0018", "name": "CA_KI",     "access": "RW",   "desc": "[15:0] 채널A Ki Q4.12"},
        {"off": "0x001C", "name": "CA_CNT",    "access": "RO",   "desc": "[15:0] 채널A 최근 주기 엔코더 카운트 (부호있는)"},
        {"off": "0x0020", "name": "CA_PWM",    "access": "RO",   "desc": "[9:0] 채널A 현재 PWM 듀티 (0=0%, 1023=100%)"},
        {"off": "0x0024", "name": "CA_ITERM",  "access": "RW",   "desc": "[31:0] 채널A 적분항 (윈드업 클리어용)"},
        {"off": "0x0030", "name": "CB_SETPT",  "access": "RW",   "desc": "[15:0] 채널B 목표 속도"},
        {"off": "0x0034", "name": "CB_KP",     "access": "RW",   "desc": "[15:0] 채널B Kp Q4.12"},
        {"off": "0x0038", "name": "CB_KI",     "access": "RW",   "desc": "[15:0] 채널B Ki Q4.12"},
        {"off": "0x003C", "name": "CB_CNT",    "access": "RO",   "desc": "[15:0] 채널B 최근 주기 엔코더 카운트"},
        {"off": "0x0040", "name": "CB_PWM",    "access": "RO",   "desc": "[9:0] 채널B 현재 PWM 듀티"},
        {"off": "0x0044", "name": "CB_ITERM",  "access": "RW",   "desc": "[31:0] 채널B 적분항"},
        {"off": "0xFFF0", "name": "ID",        "access": "RO",   "desc": "0x4D435431 (MCT1)"},
        {"off": "0xFFF4", "name": "VER",       "access": "RO",   "desc": "0x01000001"},
        {"off": "0xFFF8", "name": "IRQ_STATUS","access": "RW1C", "desc": "[0]=period_tick_event"},
        {"off": "0xFFFC", "name": "IRQ_ENABLE","access": "RW",   "desc": "[0]=period_tick_irq_en"}
      ]
    }
  ],

  "roadmap": [
