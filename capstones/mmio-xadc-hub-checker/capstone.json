  "memory_map": [
    {
      "base": "0x4009_0000",
      "size": "0x0001_0000",
      "block": "hub",
      "note": "mmio-lite 버스 기준 오프셋. 슬롯 [09] = 동결 맵 xadc 항목.",
      "regs": [
        {"off": "0x00", "name": "CTRL",     "access": "RW", "desc": "bit[1:0]=avg_len(0=1,1=4,2=8,3=16) bit2=irq_en bit3=scan_en"},
        {"off": "0x04", "name": "STATUS",   "access": "RO", "desc": "bit0=busy bit[5:2]=ch_valid[3:0]"},
        {"off": "0x08", "name": "CH0_RAW",  "access": "RO", "desc": "VAUXP/N[4] 12비트 원시값 [11:0]"},
        {"off": "0x0C", "name": "CH1_RAW",  "access": "RO", "desc": "VAUXP/N[5] 12비트 원시값 [11:0]"},
        {"off": "0x10", "name": "CH2_RAW",  "access": "RO", "desc": "VAUXP/N[12] 12비트 원시값 [11:0]"},
        {"off": "0x14", "name": "CH3_RAW",  "access": "RO", "desc": "VAUXP/N[13] 12비트 원시값 [11:0]"},
        {"off": "0x18", "name": "CH0_AVG",  "access": "RO", "desc": "채널0 이동 평균 12비트"},
        {"off": "0x1C", "name": "CH1_AVG",  "access": "RO", "desc": "채널1 이동 평균 12비트"},
        {"off": "0x20", "name": "CH2_AVG",  "access": "RO", "desc": "채널2 이동 평균 12비트"},
        {"off": "0x24", "name": "CH3_AVG",  "access": "RO", "desc": "채널3 이동 평균 12비트"},
        {"off": "0x28", "name": "IRQ_MASK", "access": "RW", "desc": "bit[3:0]: 채널별 인터럽트 마스크 (1=활성화)"},
        {"off": "0x2C", "name": "IRQ_FLAG", "access": "RW", "desc": "bit[3:0]: 채널별 변환 완료 플래그 (write 1 to clear)"}
      ]
    }
  ],
