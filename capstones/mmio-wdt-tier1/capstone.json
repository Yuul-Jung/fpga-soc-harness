        {"off": "0x000C", "name": "KICK",     "access": "WO", "desc": "아무 값 쓰면 카운터를 LOAD로 재적재, TIMEOUT_LAT 클리어"},
        {"off": "0x0010", "name": "COUNT",    "access": "RO", "desc": "현재 카운터 값"},
        {"off": "0xFFF0", "name": "ID_REG",   "access": "RO", "desc": "0x57445431 (ASCII WDT1)"},
        {"off": "0xFFF4", "name": "VER_REG",  "access": "RO", "desc": "0x00010000 (v1.0.0)"},
        {"off": "0xFFF8", "name": "IRQ_EN",   "access": "RW", "desc": "bit0=인터럽트 활성"},
        {"off": "0xFFFC", "name": "IRQ_PEND", "access": "RW", "desc": "bit0=인터럽트 대기(W1C)"}
      ]
    }
  ],
