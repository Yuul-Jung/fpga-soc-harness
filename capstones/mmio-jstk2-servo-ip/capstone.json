  "memory_map": [
    {
      "base": "0x401F_0000",
      "size": "0x10000",
      "block": "ip",
      "desc": "JSTK2 서보 IP 레지스터",
      "regs": [
        {"off": "0x0000", "name": "JSTK2_X",     "access": "RO",  "desc": "조이스틱 X축 10비트 [9:0]"},
        {"off": "0x0004", "name": "JSTK2_Y",     "access": "RO",  "desc": "조이스틱 Y축 10비트 [9:0]"},
        {"off": "0x0008", "name": "JSTK2_BTN",   "access": "RO",  "desc": "버튼 상태 [1:0] (BTN1=bit0, BTN2=bit1, 1=누름)"},
        {"off": "0x000C", "name": "SERVO_A_POS", "access": "RW",  "desc": "서보 A 펄스 폭(클럭 수). 범위 1,000,000~2,000,000. 클램프 적용."},
        {"off": "0x0010", "name": "SERVO_B_POS", "access": "RW",  "desc": "서보 B 펄스 폭(클럭 수). 범위 1,000,000~2,000,000. 클램프 적용."},
        {"off": "0x0014", "name": "CTRL",        "access": "RW",  "desc": "[0] JSTK2 샘플링 활성(1=활성), [1] 서보 출력 활성(1=활성)"},
        {"off": "0x0018", "name": "SLEW",        "access": "RW",  "desc": "서보 위치 기울기 제한(클럭/샘플). 0=제한 없음."},
        {"off": "0xFFF0", "name": "ID",          "access": "RO",  "desc": "IP ID: 0x4A535356 ('JSSV')"},
        {"off": "0xFFF4", "name": "VER",         "access": "RO",  "desc": "버전: [31:24]=1(표준rev), [15:8]=1(주), [7:0]=0(부)"},
        {"off": "0xFFF8", "name": "IRQ_STATUS",  "access": "W1C", "desc": "[0] 샘플 완료 인터럽트. 소프트웨어가 1 쓰면 소거."},
        {"off": "0xFFFC", "name": "IRQ_ENABLE",  "access": "RW",  "desc": "[0] 샘플 완료 IRQ 마스크(1=활성)"}
      ]
    }
  ],
