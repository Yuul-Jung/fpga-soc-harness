  "memory_map": [
    {
      "region": "color_lane",
      "base": "0x1005_0000",
      "size": "0x10000",
      "block": "core",
      "note": "시뮬레이션 전용 주소. 프로젝트 통합 시 0x4018_0000으로 변경.",
      "regs": [
        {
          "off": "0x00",
          "name": "CTRL",
          "access": "WO",
          "desc": "bit0=ENABLE, bit1=INT_EN, bit15=RESET"
        },
        {
          "off": "0x04",
          "name": "STATUS",
          "access": "RC",
          "desc": "bit0=FRAME_DONE, bit2:1=LANE[1:0](1=L,2=C,3=R), bit3=JUMP"
        },
        {
          "off": "0x08",
          "name": "THRESH",
          "access": "RW",
          "desc": "bit5:0=green_thresh (G[10:5] 비교 임계값, 기본=20)"
        },
        {
          "off": "0x0C",
          "name": "COL_CFG",
          "access": "RW",
          "desc": "bit9:0=col_thr1, bit25:16=col_thr2 (열 경계 위치, 기본=3,6)"
        },
        {
          "off": "0x10",
          "name": "ROW_CFG",
          "access": "RW",
          "desc": "bit8:0=row_thr1, bit24:16=row_thr2 (행 경계 위치, 기본=3,6)"
        },
        {
          "off": "0x14",
          "name": "FRAME_CNT",
          "access": "RO",
          "desc": "bit7:0=프레임 완료 카운터 (오버플로 허용)"
        },
        {
          "off": "0xFC",
          "name": "ID_VER",
          "access": "RO",
          "desc": "0x0007_0100 (ID=0x07, VER=1.0)"
        }
      ]
    }
  ],
