  "howto": [
    {
      "title": "시뮬레이션 (iverilog)",
      "steps": [
        "make lint  — RTL 문법 검사 (iverilog -g2001 -Wall)",
        "make sim   — 자체 점검 테스트벤치 실행; PASS all 7 checks 확인",
        "make synth — yosys로 자원 추정 (XC7A35T 기준)"
      ]
    },
    {
      "title": "Vivado 합성",
      "steps": [
        "rtl/qenc_diag.v, rtl/axil_qenc_wrap.v, rtl/basys3_qenc_top.v를 프로젝트에 추가한다.",
        "constr/qenc_basys3.xdc를 제약 파일로 추가한다.",
        "top=basys3_qenc_top으로 합성·구현한다.",
        "합성 후 LUT/FF/BRAM 사용량과 WNS를 기록한다.",
        "AXI4-Lite 포트는 set_false_path 처리됨. MicroBlaze V SoC 통합 시 AXI4-Lite 버스에 연결한다."
      ]
    }
  ],
