  "memory_map": [
    {
      "base": "0x400F_0000",
      "size": "0x10000",
      "block": "wrap",
      "region": "qenc_diag",
      "regs": [
        {
          "off": "0x00",
          "name": "CTRL",
          "access": "RW",
          "desc": "bit0=EN(enable), bit1=SRST(소프트 리셋), bit2=WINDOW_EN(창 속도 계산 활성)"
        },
        {
          "off": "0x04",
          "name": "POSITION",
          "access": "RO",
          "desc": "32비트 부호 있는 위치 카운터 (4체배 펄스 수)"
        },
        {
          "off": "0x08",
          "name": "VELOCITY",
          "access": "RO",
          "desc": "16비트 최근 10ms 창 카운트 (부호 없음)"
        },
        {
          "off": "0x0C",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0=DIR(0=정방향,1=역방향), bit1=OVFL(위치 오버플로 래치), bit2=ERR_LATCH(오류 발생 래치)"
        },
        {
          "off": "0x10",
          "name": "ERROR_CNT",
          "access": "RO",
          "desc": "16비트 불가능 전이 오류 누산 카운터"
        }
      ]
    }
  ],
