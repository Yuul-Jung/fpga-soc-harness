      ]
    },
    {
      "base": "0x1001_0000",
      "size": "0x10000",
      "block": "uart",
      "regs": [
        {
          "off": "0x00",
          "name": "DATA",
          "access": "WO",
          "desc": "하위 8비트 송신 시작. busy 중 무시"
        },
        {
          "off": "0x04",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0 = busy"
        }
      ]
    },
    {
      "base": "0x1002_0000",
      "size": "0x10000",
      "block": "i2s",
      "regs": [
        {
          "off": "0x0000",
          "name": "CTRL",
          "access": "RW",
          "desc": "bit[0]=TX_EN. 1이면 연속 송신 활성화"
        },
        {
          "off": "0x0004",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit[0]=active(TX_EN과 동일)"
        },
        {
          "off": "0x0008",
          "name": "L_DATA",
          "access": "WO",
          "desc": "다음 프레임에 사용할 왼쪽 채널 16비트 샘플 [15:0]"
        },
        {
          "off": "0x000C",
          "name": "R_DATA",
          "access": "WO",
          "desc": "다음 프레임에 사용할 오른쪽 채널 16비트 샘플 [15:0]"
        },
        {
          "off": "0xFFF0",
          "name": "ID",
          "access": "RO",
          "desc": "0x49325354 ('I2ST')"
        },
        {
          "off": "0xFFF4",
          "name": "VER",
          "access": "RO",
          "desc": "0x01000001: std_rev=1, major=0, minor=1"
        },
        {
          "off": "0xFFF8",
          "name": "IRQ_STATUS",
          "access": "W1C",
          "desc": "bit[0]=frame_done. 1쓰면 클리어(W1C)"
        },
        {
          "off": "0xFFFC",
          "name": "IRQ_ENABLE",
          "access": "RW",
          "desc": "bit[0]=frame_done 인터럽트 활성화"
        }
      ]
    }
  ],
