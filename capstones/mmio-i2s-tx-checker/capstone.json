  "bus_protocol": {
    "name": "mmio-lite",
    "signals": [
      {
        "name": "m_valid",
        "dir": "master→slave",
        "desc": "요청 유효"
      },
      {
        "name": "m_we",
        "dir": "master→slave",
        "desc": "1이면 쓰기"
      },
      {
        "name": "m_addr[31:0]",
        "dir": "master→slave",
        "desc": "바이트 주소, 4바이트 정렬"
      },
      {
        "name": "m_wdata[31:0]",
        "dir": "master→slave",
        "desc": "쓰기 데이터"
      },
      {
        "name": "m_rdata[31:0]",
        "dir": "slave→master",
        "desc": "읽기 데이터 (조합 경로)"
      },
      {
        "name": "m_ready",
        "dir": "slave→master",
        "desc": "항상 1: 모든 접근은 1사이클"
      }
    ],
    "note": "주소 [31:16]으로 슬레이브 선택, [15:0]이 슬레이브 내 오프셋. i2s_tx는 0xFFF0~FFFC(mgmt 레지스터)에 접근하므로 16비트 오프셋이 필요하다."
  },
