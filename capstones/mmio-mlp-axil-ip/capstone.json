  "memory_map": [
    {
      "region": "mlp_axil_ip",
      "base": "0x402F_0000",
      "size": "0x10000",
      "block": "IP",
      "regs": [
        {
          "off": "0x00",
          "name": "CONTROL",
          "access": "W",
          "desc": "[0]=start, [1]=load_mode, [2]=clear_done"
        },
        {
          "off": "0x04",
          "name": "STATUS",
          "access": "R",
          "desc": "[0]=busy, [1]=done(sticky)"
        },
        {
          "off": "0x08",
          "name": "RESULT",
          "access": "R",
          "desc": "예측 클래스 [3:0]"
        },
        {
          "off": "0x0C",
          "name": "CONFIDENCE",
          "access": "R",
          "desc": "FC2 최대 누산값 하위 32비트"
        },
        {
          "off": "0x10",
          "name": "LOAD_ADDR",
          "access": "R/W",
          "desc": "대상 메모리 쓰기 인덱스"
        },
        {
          "off": "0x14",
          "name": "LOAD_DATA",
          "access": "W",
          "desc": "스트리밍 데이터 포트 (바이트 단위 [7:0])"
        },
        {
          "off": "0x18",
          "name": "LOAD_TARGET",
          "access": "W",
          "desc": "0=W1, 1=B1, 2=W2, 3=B2, 4=INPUT"
        },
        {
          "off": "0x1C",
          "name": "VERSION",
          "access": "R",
          "desc": "0x00010000 (v1.0)"
        }
      ]
    }
  ],
