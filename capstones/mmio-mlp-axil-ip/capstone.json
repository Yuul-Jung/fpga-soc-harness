  "bus_protocol": {
    "name": "AXI4-Lite",
    "data_width": 32,
    "addr_width": 8,
    "signals": [
      "awvalid",
      "awready",
      "awaddr",
      "wvalid",
      "wready",
      "wdata",
      "wstrb",
      "bvalid",
      "bready",
      "bresp",
      "arvalid",
      "arready",
      "araddr",
      "rvalid",
      "rready",
      "rdata",
      "rresp"
    ],
    "note": "단순화: bresp/rresp = 2'b00 고정, wstrb는 무시(32비트 전체 쓰기)"
  },
  "integration": {
    "bus": "AXI4-Lite",
    "address_map": "mbv-frozen-v2",
    "compat": "compatible",
    "plan": "동결 맵 슬롯 [2F] = 0x402F_0000에 배정. MicroBlaze V에서 Xil_Out32/Xil_In32로 직접 접근 가능. 인터럽트 없음(폴링 방식).",
    "frozen_mapping": {
      "IP": "[2F] 0x402F_0000"
    }
  },
