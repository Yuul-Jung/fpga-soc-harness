  "memory_map": [
    {
      "base": "0x4016_0000",
      "size": "0x10000",
      "block": "axil",
      "desc": "소리·기울기·LED 매트릭스 IP 레지스터 공간 (free_slot [16] 제안, 동결 전, 인터럽트 없음)",
      "regs": [
        {
          "off": "0x00",
          "name": "CTRL",
          "access": "RW",
          "desc": "bit0=IP_EN, bit1=SOFT_RST, bit2=PDM_CLK_EN, bit3=ADXL_EN"
        },
        {
          "off": "0x04",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0=PDM_VALID, bit1=ADXL_VALID, bit7=IIR_BUSY, [15:8]=8대역 활성 플래그"
        },
        {
          "off": "0x08",
          "name": "MODE",
          "access": "RW",
          "desc": "bit1:0: 00=소리막대, 01=기울기점, 10=혼합(소리+기울기 오버레이)"
        },
        {
          "off": "0x0C",
          "name": "BRIGHT",
          "access": "RW",
          "desc": "[3:0] MAX7219 밝기 0x0(최저)~0xF(최고). 초기값 0x8"
        },
        {
          "off": "0x10",
          "name": "TILT_X",
          "access": "RO",
          "desc": "[9:0] ADXL345 X축 가속도(2의 보수, ±2g)"
        },
        {
          "off": "0x14",
          "name": "TILT_Y",
          "access": "RO",
          "desc": "[9:0] ADXL345 Y축 가속도(2의 보수, ±2g)"
        },
        {
          "off": "0x18",
          "name": "ENERGY0",
          "access": "RO",
          "desc": "[31:0] 대역0(저주파 ~200Hz) 에너지 누산값"
        },
        {
          "off": "0x1C",
          "name": "ENERGY1",
          "access": "RO",
          "desc": "[31:0] 대역1(200~400Hz) 에너지"
        },
        {
          "off": "0x20",
          "name": "ENERGY2",
          "access": "RO",
          "desc": "[31:0] 대역2(400~700Hz)"
        },
        {
          "off": "0x24",
          "name": "ENERGY3",
          "access": "RO",
          "desc": "[31:0] 대역3(700~1100Hz)"
        },
        {
