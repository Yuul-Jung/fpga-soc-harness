    {
      "title": "Vivado 합성 (보드)",
      "steps": [
        "Vivado 2024.2 에서 새 프로젝트 생성 (xc7a35tcpg236-1)",
        "rtl/*.v, constr/basys3_top.xdc 추가",
        "상위 모듈 basys3_top 선택 후 Generate Bitstream",
        "Programming 후 minicom 115200 8N1 접속하여 쓰기/읽기 명령 테스트"
      ]
    }
  ],
  "verification": {
    "lint": "verilator --lint-only -Wall -Wno-fatal --top-module basys3_top rtl/uart_rx.v rtl/uart_tx.v rtl/uart_axilite_bridge.v rtl/basys3_top.v",
    "sim": "iverilog -g2005 -o build/sim.vvp tb/tb_uart_axilite_bridge.v rtl/uart_rx.v rtl/uart_tx.v rtl/uart_axilite_bridge.v && vvp build/sim.vvp | grep -E 'PASS|FAIL'",
    "synth": "yosys -p 'read_verilog rtl/uart_rx.v rtl/uart_tx.v rtl/uart_axilite_bridge.v rtl/basys3_top.v; synth_xilinx -top basys3_top -family xc7; stat'",
