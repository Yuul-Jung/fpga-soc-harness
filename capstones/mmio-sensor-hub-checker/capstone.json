  "bus_protocol": {
    "name": "mmio-lite",
    "signals": [
      {
        "name": "addr[31:0]",
        "dir": "master→slave",
        "desc": "바이트 주소, 4바이트 정렬"
      },
      {
        "name": "wdata[31:0]",
        "dir": "master→slave",
        "desc": "쓰기 데이터"
      },
      {
        "name": "we",
        "dir": "master→slave",
        "desc": "1이면 쓰기"
      },
      {
        "name": "sel",
        "dir": "master→slave",
        "desc": "1이면 이 사이클에 접근"
      },
      {
        "name": "rdata[31:0]",
        "dir": "slave→master",
        "desc": "읽기 데이터 (조합 경로)"
      }
    ],
    "note": "단순 단일 사이클 버스. 실제 AXI4-Lite로 교체 시 integration.plan 참조."
  },
  "integration": {
    "bus": "mmio-lite (자체, 단독 실행용)",
    "address_map": "custom",
    "compat": "incompatible",
    "target_map": "mbv-frozen-v2",
    "plan": "이 패키지는 단독 시뮬레이션·보드 확인용으로 자체 mmio-lite 버스(0x1000_xxxx~0x1002_xxxx)를 쓴다. 동결 맵(mbv-frozen-v2) 이식 계획: (1) GPIO·UART는 동결 맵 [00]/[02] AMD IP를 그대로 쓰고 드라이버를 맞춘다. (2) sensor_hub는 동결 맵 [16](0x4016_0000)에 IP 표준(64KB 창, 0xFFF0 ID/VER)으로 감싸서 AXI4-Lite 슬레이브로 등록한다. (3) demo_master 대신 MicroBlaze V + 폴링 드라이버(C) 또는 인터럽트(irq→INTC)로 교체한다. HC-SR04 ECHO 5V→3.3V 레벨 변환 필수. DHT11·SDA·SCL 풀업 4.7 kΩ 필요.",
    "frozen_mapping": [
      {
        "block": "gpio",
        "region": "[00] gpio_led_sw 0x4000_0000"
      },
      {
        "block": "uart",
        "region": "[02] uart_lite   0x4002_0000"
      },
      {
        "block": "sensor_hub",
        "region": "[16] sensor_hub  0x4016_0000"
      }
    ]
  },
