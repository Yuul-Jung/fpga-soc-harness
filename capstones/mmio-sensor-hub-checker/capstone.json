        {
          "off": "0x04",
          "name": "STATUS",
          "access": "RO",
          "desc": "bit0=busy"
        }
      ]
    },
    {
      "base": "0x1002_0000",
      "size": "0x10000",
      "block": "sensor_hub",
      "desc": "센서 허브: HC-SR04 + DHT11 + I2C 마스터",
      "regs": [
        {
          "off": "0x00",
          "name": "HCSR04_CTRL",
          "access": "WO",
          "desc": "bit0=start (1 클럭 쓰면 트리거 발생)"
        },
        {
          "off": "0x04",
          "name": "HCSR04_STATUS",
          "access": "RO",
          "desc": "bit0=busy, bit1=done, bit2=timeout"
        },
        {
          "off": "0x08",
          "name": "HCSR04_DIST",
          "access": "RO",
          "desc": "측정 거리 cm [15:0] (최대 400)"
        },
        {
          "off": "0x10",
          "name": "DHT11_CTRL",
          "access": "WO",
          "desc": "bit0=start"
        },
        {
          "off": "0x14",
          "name": "DHT11_STATUS",
          "access": "RO",
          "desc": "bit0=busy, bit1=done, bit2=checksum_ok"
        },
        {
          "off": "0x18",
          "name": "DHT11_HUMID",
          "access": "RO",
          "desc": "습도 정수부 [7:0]"
        },
        {
          "off": "0x1C",
          "name": "DHT11_TEMP",
          "access": "RO",
          "desc": "온도 정수부 [7:0]"
        },
        {
          "off": "0x20",
          "name": "I2C_CMD",
          "access": "WO",
          "desc": "bit0=start, bit[7:1]=dev_addr[6:0], bit[15:8]=reg_addr[7:0]"
        },
        {
          "off": "0x24",
          "name": "I2C_STATUS",
          "access": "RO",
          "desc": "bit0=busy, bit1=done, bit2=error (NACK)"
        },
        {
          "off": "0x28",
          "name": "I2C_RDATA",
          "access": "RO",
          "desc": "읽은 바이트 [7:0]"
        }
      ]
    }
  ],
